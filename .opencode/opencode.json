{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "todo": true
  },
  "lsp": {},
  "instructions": [
    ".opencode/pstack-models.md",
    ".opencode/instructions/INSTRUCTIONS.md"
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "ui-skills": {
        "type": "remote",
        "url": "https://www.ui-skills.com/mcp"
      }
    }
  },
  "agents": {
    "planner": {
      "description": "Expert planning specialist for complex features and refactoring. Use for implementation planning, architectural changes, or complex refactoring.",
      "mode": "subagent",
      "system": "{file:prompts/agents/planner.txt}",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "code-reviewer": {
      "description": "Expert code review specialist. Reviews code for quality, security, and maintainability. Use immediately after writing or modifying code.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash#max",
      "system": "{file:prompts/agents/code-reviewer.txt}",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "security-reviewer": {
      "description": "Security vulnerability detection and remediation specialist. Use after writing code that handles user input, authentication, API endpoints, or sensitive data.",
      "mode": "subagent",
      "system": "{file:prompts/agents/security-reviewer.txt}",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "tdd-guide": {
      "description": "Test-Driven Development specialist enforcing write-tests-first methodology. Use when writing new features, fixing bugs, or refactoring. Ensures 80%+ test coverage.",
      "mode": "subagent",
      "system": "{file:prompts/agents/tdd-guide.txt}",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "build-error-resolver": {
      "description": "Build and TypeScript error resolution specialist. Use when build fails or type errors occur. Fixes build/type errors only with minimal diffs.",
      "mode": "subagent",
      "system": "{file:prompts/agents/build-error-resolver.txt}",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "e2e-runner": {
      "description": "End-to-end testing specialist using Playwright. Generates, maintains, and runs E2E tests for critical user flows.",
      "mode": "subagent",
      "system": "{file:prompts/agents/e2e-runner.txt}",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "doc-updater": {
      "description": "Documentation and codemap specialist. Use for updating codemaps and documentation.",
      "mode": "subagent",
      "system": "{file:prompts/agents/doc-updater.txt}",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "refactor-cleaner": {
      "description": "Dead code cleanup and consolidation specialist. Use for removing unused code, duplicates, and refactoring.",
      "mode": "subagent",
      "system": "{file:prompts/agents/refactor-cleaner.txt}",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  }
}

# JobScrape backend (.NET 10) — scoped ignores.
# Root .gitignore already covers build outputs; this file keeps
# src/backend self-describing when viewed or moved on its own.

[Bb]in/
[Oo]bj/
out/
publish/

# Test / coverage output produced inside this folder
TestResults/
coverage/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml

# Local runtime data (never commit databases, profiles, exports)
artifacts/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local config / secrets
appsettings.Local.json
appsettings.Development.json
.env
.env.*

# MSBuild logs
*.binlog

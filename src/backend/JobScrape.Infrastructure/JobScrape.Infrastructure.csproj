<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- TreatWarningsAsErrors is enforced globally in Directory.Build.props;
         repeated here so the rule survives outside that hierarchy. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- Design-time only (migrations); never flows to consumers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobScrape.Domain\JobScrape.Domain.csproj" />
    <ProjectReference Include="..\JobScrape.Application\JobScrape.Application.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- TreatWarningsAsErrors is enforced globally in Directory.Build.props;
         repeated here so the rule survives outside that hierarchy. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Tests are exempt from the global XML-documentation rule: test names
         state the expectation, and examples live in docs/06-testing-strategy.md. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobScrape.Domain\JobScrape.Domain.csproj" />
    <ProjectReference Include="..\JobScrape.Application\JobScrape.Application.csproj" />
    <ProjectReference Include="..\JobScrape.Infrastructure\JobScrape.Infrastructure.csproj" />
    <ProjectReference Include="..\JobScrape.Api\JobScrape.Api.csproj" />
  </ItemGroup>
</Project>

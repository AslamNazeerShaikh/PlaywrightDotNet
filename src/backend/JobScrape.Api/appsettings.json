{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "JobScrape": {
    "Storage": {
      "DatabasePath": "artifacts/data/jobscrape.db",
      "ArtifactsRoot": "artifacts",
      "ProfilesRoot": "artifacts/profiles",
      "RetentionDays": 30,
      "PostingRetentionDays": 180,
      "MinimumFreeDiskBytes": 1073741824
    },
    "Compliance": {
      "AcknowledgeSourceRisk": false,
      "AllowHighRiskSources": false
    },
    "Run": {
      "RetryMaxAttempts": 2
    },
    "Browser": {
      "Headless": false,
      "NavigationTimeoutSeconds": 45,
      "AdblockMode": null,
      "ExtensionDir": null
    },
    "Logging": {
      "Directory": "artifacts/logs",
      "RetentionDays": 90,
      "FileSizeLimitBytes": 104857600
    },
    "Jwt": {
      // Development-only default: plain `dotnet run` works with no extra
      // CLI parameters or environment. Production replaces this section
      // from the secret store via CI/CD at deploy time; never ship a real
      // secret here. The secret itself is never logged.
      "Secret": "dev-local-only-rotate-in-production-0123456789abcdef",
      "Issuer": "jobscrape",
      "Audience": "jobscrape-api",
      "TokenLifetimeMinutes": 60,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "AdminSeed": {
      // Development-only default: the first boot seeds this admin with no
      // extra CLI parameters or environment. Production replaces these
      // values from the secret store via CI/CD at deploy time. A missing
      // or empty section skips seeding (legacy ADMIN_EMAIL /
      // ADMIN_SETUP_SECRET environment variables apply only then).
      "Email": "admin@example.com",
      "SetupSecret": "Setup-Test-12!!"
    },
    "Sources": {
      "naukri": {
        "Enabled": true,
        "BaseUrl": "https://www.naukri.com",
        "MaxPagesPerSearch": 3,
        "MaxJobsPerRun": 60,
        "MaxPagesCeiling": 1000,
        "MaxJobsCeiling": 20000,
        "MaxDetailsPerRun": 60,
        "MinDelayMs": 2500,
        "MaxDelayMs": 6000,
        "DailyPageCap": 1000,
        "DailyDetailCap": 60,
        "UnlimitedRunCap": true,
        "ChallengeCooldownMinutes": 45
      },
      "indeed": {
        "Enabled": false,
        "BaseUrl": "https://in.indeed.com",
        "MaxPagesPerSearch": 2,
        "MaxJobsPerRun": 40,
        "MaxDetailsPerRun": 30,
        "MinDelayMs": 12000,
        "MaxDelayMs": 25000,
        "DailyPageCap": 12,
        "DailyDetailCap": 30,
        "DailyRunCap": 1,
        "ChallengeCooldownMinutes": 60
      },
      "linkedin": {
        "Enabled": false,
        "BaseUrl": "https://www.linkedin.com",
        "MaxPagesPerSearch": 1,
        "MaxJobsPerRun": 25,
        "MaxDetailsPerRun": 8,
        "MinDelayMs": 10000,
        "MaxDelayMs": 20000,
        "DailyPageCap": 4,
        "DailyDetailCap": 8,
        "DailyRunCap": 1,
        "ChallengeCooldownMinutes": 60
      }
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- TreatWarningsAsErrors is enforced globally in Directory.Build.props;
         repeated here so the rule survives outside that hierarchy. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Process" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Enrichers.Span" />
    <PackageReference Include="Serilog.Enrichers.AssemblyName" />
    <PackageReference Include="Serilog.Exceptions" />
    <PackageReference Include="Serilog.Enrichers.Demystifier" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobScrape.Domain\JobScrape.Domain.csproj" />
    <ProjectReference Include="..\JobScrape.Application\JobScrape.Application.csproj" />
    <ProjectReference Include="..\JobScrape.Infrastructure\JobScrape.Infrastructure.csproj" />
  </ItemGroup>
</Project>

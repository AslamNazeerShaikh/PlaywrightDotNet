# Copy to .env for local overrides. Never commit .env itself.
# The BFF proxies /api/* to the .NET data plane, which must be running first:
#   dotnet run --project src/backend/JobScrape.Api/JobScrape.Api.csproj
# (launchSettings serves http://localhost:5207 and https://localhost:5208).
PORT=3000
# HTTPS upstream (matches the API's https applicationUrl). Requires the
# one-time dev-cert trust + export below; otherwise fall back to
# DOTNET_API_URL=http://127.0.0.1:5207 (no cert needed).
DOTNET_API_URL=https://localhost:5208
# Path of the exported dev-cert public cert so Bun trusts the API over TLS.
# Baked into dev:server/api:types scripts (Bun reads its CA store before
# .env loads), kept here so the path is discoverable.
NODE_EXTRA_CA_CERTS=./.certs/devcert.pem
# Serve the deck itself over HTTPS with the same dev cert (CN=localhost
# covers 127.0.0.1 too). Comment both out for plain-http BFF.
BFF_TLS_CERT_FILE=./.certs/localhost-cert.pem
BFF_TLS_KEY_FILE=./.certs/localhost-key.pem
